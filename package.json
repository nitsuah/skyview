{
  "name": "skyview",
  "version": "1.0.0",
  "description": "A stunning, high-tech website for professional drone services featuring a minimalist design with full-bleed photography, dark high-contrast aesthetics, and glassmorphic UI elements.",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "netlify dev",
    "dev:platform": "cd platform && npm run dev",
    "db:migrate": "node scripts/migrate.js",
    "test": "playwright test --config config/playwright.config.ts",
    "test:journeys": "playwright test --config config/playwright.journeys.config.ts",
    "test:unit": "vitest run --config config/vitest.config.ts",
    "lint:js": "eslint . --config config/eslint.config.mjs",
    "lint:css": "stylelint \"**/*.css\" --config config/stylelint.config.mjs",
    "optimize:images": "node scripts/convert-to-webp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitsuah/skyview.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nitsuah/skyview/issues"
  },
  "homepage": "https://github.com/nitsuah/skyview#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "netlify-cli": "^27.20.1",
    "sharp": "^0.35.5",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@netlify/blobs": "^11.1.6",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
    "resend": "^6.39.0",
    "stripe": "^23.2.0"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "minimatch": "^11.0.4",
    "ipx": "4.0.0-beta.1",
    "@opentelemetry/api": "^1.9.0",
    "glob": "^14.0.6"
  }
}
