################################################################################
# SkyView Dynamics — Environment Variables
#
# Local dev: copy this file to .env, fill in your values, then run:
#   netlify dev
#
# Production: set these in the Netlify dashboard → Site → Environment variables.
# Do NOT commit .env to version control.
################################################################################

# ------------------------------------------------------------------------------
# Database (Neon serverless Postgres)
# Get this from: https://console.neon.tech → your project → Connection string
# Use the "Pooled connection" string (ends with ?sslmode=require)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 random characters. Never reuse across projects.
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_32_CHARS_MIN

# ------------------------------------------------------------------------------
# Email — Resend
# Sign up at: https://resend.com → API Keys → Create API Key
# Also verify your sending domain (skyviewdynamics.com) under Domains.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Stripe (Phase 2 — leave blank until ready to accept payments)
# Sign up at: https://dashboard.stripe.com → Developers → API keys
# Use test keys (sk_test_...) for local dev; live keys for production.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# Netlify (auto-injected in Netlify runtime — only needed for local Blobs dev)
# Find NETLIFY_SITE_ID in Netlify dashboard → Site → General → Site details
# ------------------------------------------------------------------------------
NETLIFY_SITE_ID=your-netlify-site-id
# NETLIFY_BLOBS_TOKEN is only needed for local dev; in production it is injected automatically.
# Generate a personal access token at: https://app.netlify.com/user/applications
NETLIFY_BLOBS_TOKEN=nfp_XXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------------------------
# Legacy / unused — kept for reference
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=8888
