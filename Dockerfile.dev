FROM node:22-alpine

RUN npm install -g netlify-cli@latest

WORKDIR /app

# Install root deps (functions)
COPY package*.json ./
RUN npm install

# Install platform deps
COPY platform/package*.json ./platform/
RUN cd platform && npm install

# Copy source
COPY . .
RUN chown -R node:node /app
USER node

EXPOSE 8888

CMD ["netlify", "dev", "--port", "8888", "--offline", "--no-open"]
